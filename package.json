{
   "name": "vue3-vite-ts-pinia-tailwind-project",
   "version": "1.12.0",
   "private": true,
   "type": "module",
   "scripts": {
      "autod": "autod",
      "build": "tsc --noEmit && vite build",
      "build:no-check": "vite build",
      "build:staging": "cross-env mode=staging tsc --noEmit && vite build --mode staging",
      "dev": "vite --host",
      "dev:check": "tsc --noEmit && npm run dev",
      "dev:force": "vite --host --force",
      "install-org": "npm --registry https://registry.npmjs.org install",
      "prepare": "husky",
      "preview": "npm run build && vite preview --host",
      "preview:no-check": "npm run build:no-check && vite preview --host",
      "preview:staging": "npm run build:staging && vite preview --host",
      "type-check": "tsc --noEmit"
   },
   "dependencies": {
      "@element-plus/icons-vue": "^2.3.2",
      "@vueuse/core": "^14.1.0",
      "axios": "^1.11.0",
      "big-axios": "^1.3.3",
      "big-element": "^1.3.4",
      "crypto-js": "^4.2.0",
      "echarts": "^5.6.0",
      "echarts-util": "^1.4.0",
      "element-plus": "^2.11.9",
      "file-saver": "^2.0.5",
      "jsencrypt": "3.2.1",
      "moment": "^2.30.1",
      "pinia": "^3.0.3",
      "pinia-plugin-persistedstate": "^4.4.1",
      "text-security": "^3.2.1",
      "vue": "^3.5.25",
      "vue-echarts": "^7.0.3",
      "vue-router": "^4.6.3"
   },
   "devDependencies": {
      "@commitlint/cli": "^19.8.1",
      "@commitlint/config-conventional": "^19.8.1",
      "@eslint/eslintrc": "^3.3.1",
      "@eslint/js": "^9.31.0",
      "@types/crypto-js": "^4.2.2",
      "@types/file-saver": "^2.0.7",
      "@typescript-eslint/eslint-plugin": "^8.38.0",
      "@typescript-eslint/parser": "^8.38.0",
      "@vitejs/plugin-vue": "^6.0.0",
      "@vitejs/plugin-vue-jsx": "^5.0.1",
      "autod": "^3.1.2",
      "autoprefixer": "^10.4.21",
      "cross-env": "^7.0.3",
      "eslint": "^9.31.0",
      "eslint-config-prettier": "^10.1.8",
      "globals": "^16.3.0",
      "husky": "^9.1.7",
      "less": "^4.4.0",
      "prettier": "^3.6.2",
      "prettier-plugin-packagejson": "^2.5.19",
      "prettier-plugin-tailwindcss": "^0.6.14",
      "sharp": "^0.34.3",
      "svgo": "^4.0.0",
      "tailwindcss": "^3.4.17",
      "typescript": "^5.8.3",
      "unplugin-auto-import": "^19.3.0",
      "vite": "^7.0.6",
      "vite-plugin-checker": "^0.10.1",
      "vite-plugin-compression": "^0.5.1",
      "vite-plugin-image-optimizer": "^2.0.2",
      "vite-plugin-remove-console": "^2.2.0",
      "vite-plugin-svg-icons": "^2.0.1",
      "vite-plugin-vue-setup-extend": "^0.4.0",
      "vue-eslint-parser": "^10.2.0"
   },
   "engines": {
      "node": ">=22.16.0",
      "npm": ">=10.9.2"
   }
}
